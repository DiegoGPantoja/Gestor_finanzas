QWidget {
    background-color: #1e1e2e;
    color: #ffffff;
    font-family: Arial, sans-serif;
    font-size: 14px;
}

/* Botones */
QPushButton {
    background-color: #3b82f6;
    border: none;
    color: white;
    padding: 10px;
    border-radius: 5px;
    font-size: 16px;
}

QPushButton:hover {
    background-color: #2563eb;
}

QPushButton#btn_ingreso {
    background-color: #16a34a; /* Verde */
}

QPushButton#btn_ingreso:hover {
    background-color: #15803d;
}

QPushButton#btn_gasto {
    background-color: #dc2626; /* Rojo */
}

QPushButton#btn_gasto:hover {
    background-color: #b91c1c;
}

/* Botón de engranaje */
QPushButton#menu_button {
    background-color: transparent;
    border: none;
    padding: 5px;
}

QPushButton#menu_button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 5px;
}

/* Campos de texto */
QLineEdit {
    background-color: #2e2e3a;
    border: 1px solid #3b82f6;
    color: white;
    padding: 8px;
    border-radius: 4px;
}

QLineEdit:focus {
    border: 1px solid #60a5fa;
}

/* Labels */
QLabel {
    font-size: 18px;
    font-weight: bold;
}

/* Historial */
QListWidget {
    background-color: #2e2e3a;
    border: 1px solid #44475a;
    color: white;
    padding: 5px;
    border-radius: 4px;
}

/* Menú desplegable */
QWidget#menu_container {
    background-color: #2e2e3a;
    border-radius: 8px;
    padding: 10px;
}

/* Menú desplegable (QComboBox) */
QComboBox {
    background-color: #2e2e3a;
    border: 1px solid #3b82f6;
    padding: 5px;
    border-radius: 4px;
    color: white;
}

QComboBox QAbstractItemView {
    background-color: #2e2e3a;
    border: 1px solid #3b82f6;
    selection-background-color: #3b82f6;
    color: white;
}
QMenu {
                font-size: 18px;
                background-color: #2196F3;
                border: 1px solid #ccc;
                padding: 12px;
                min-width: 220px;
                border-radius: 8px;
            }
            QMenu::item {
                padding: 12px 20px;
                color: white;
                background-color: transparent;
                border-radius: 4px;
            }
            QMenu::item:selected {
                background-color: #1565C0;
                color: #fff;
            }
QDateEdit {
                background-color: #2c2c2c;  /* Fondo oscuro */
                color: white;  /* Texto blanco */
                font-size: 14px;
                padding: 5px;
                border: 1px solid #555;  /* Borde sutil */
                border-radius: 5px;  /* Bordes redondeados */
            }
            QDateEdit::drop-down {
                subcontrol-origin: padding;
                subcontrol-position: right;
                width: 20px;
                border-left: 1px solid #555;
            }
            QDateEdit::down-arrow {
                image: url(:imagenes/caledario.png); /* Personaliza el ícono si tienes uno */
                width: 12px;
                height: 12px;
            }